# BharatBid — Root .gitignore

# Env secrets — NEVER commit
.env
.env.local
.env.*.local
*.env

# Node
node_modules/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# TypeScript build cache
*.tsbuildinfo

# Uploads (local dev only)
uploads/
backend-api/uploads/

# Prisma
backend-api/prisma/dev.db
backend-api/prisma/dev.db-journal

# Test artifacts
coverage/
*.snap

# Frontend build & modules
bharatbid/node_modules/
bharatbid/dist/

# Scratch & temporary
scratch/
backend-api/scratch/

# Omit docs files per instruction
/docs/
bharatbid/docs/
backend-api/docs/
ANTIGRAVITY_*.md
BACKEND_BUILD_PLAYBOOK*.md
.pgdata/

# Do not ignore src/docs
!backend-api/src/docs/
!backend-api/src/docs/**
!bharatbid/.env.production
