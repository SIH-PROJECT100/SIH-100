# ==============================================================================
# GeM Bid Compliance Verification Platform — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development # Options: 'development' | 'production' | 'test'

# PostgreSQL Database Connections (Dual-role: restricted app user + admin migration user)
# DATABASE_URL: App-level connection using least-privilege backend_app role (blocked from UPDATE/DELETE on ledger_entries)
DATABASE_URL="postgresql://backend_app:<secret>@localhost:5432/gem_compliance?schema=public"
# DIRECT_URL: Admin-level connection (superuser/migrations) used by Prisma CLI during db push/migrate
DIRECT_URL="postgresql://postgres:<secret>@localhost:5432/gem_compliance?schema=public"

# Authentication & Session Security (Phase 8 RFC 7519 + NIST SP 800-63B)
# JWT_SECRET: Secret for signing HS256 tokens (min 16 chars)
JWT_SECRET="generate_at_least_16_characters_secret_gem_2026"
# MAX_SESSION_LIFETIME_SEC: Absolute maximum lifespan for JWT refresh token chaining (default: 43200s / 12 hours)
MAX_SESSION_LIFETIME_SEC=43200

# Google Gemini AI Configuration (Phases 2 & 9)
# GEMINI_API_KEY: Live Google AI Studio API key starting with "AIzaSy..."
GEMINI_API_KEY="your_gemini_api_key_from_ai_studio"
# GEMINI_MODEL_FAST: Ultra-low latency model for structured extraction and fast classification
GEMINI_MODEL_FAST=gemini-2.5-flash
# GEMINI_MODEL_REASONING: High-capacity reasoning model for complex discrepancies and anomaly analysis
GEMINI_MODEL_REASONING=gemini-2.5-pro

# OCR & Document Processing
# OCR_FALLBACK_MODE: Engine for extracting text when PDF digital text layer is missing ('tesseract' | 'paddle')
OCR_FALLBACK_MODE=tesseract
# PADDLE_OCR_URL: Sidecar container URL if paddle OCR mode is selected
PADDLE_OCR_URL=http://localhost:8001

# DigiLocker & PKI Verification (Phase 2 & 7)
# DIGILOCKER_MODE: Mode of DigiLocker XML/X.509 signature verification ('mock' | 'sandbox' | 'production')
DIGILOCKER_MODE=mock
# DIGILOCKER_MOCK_ROOT_CERT_PATH: Local filesystem path to mock CCA India root certificate for offline demo verification
DIGILOCKER_MOCK_ROOT_CERT_PATH=./demo/mock-cca-root.pem

# Verification Orchestrator & Resilience (Phase 2 & 7)
# VERIFICATION_TIMEOUT_MS: Maximum allowed runtime per verification tier call in ms (SLA < 8000ms, default: 10000ms)
VERIFICATION_TIMEOUT_MS=10000
# VERIFICATION_MAX_RETRIES: Exponential backoff attempt count on transient upstream network/API failures
VERIFICATION_MAX_RETRIES=3

# Confidence Scoring Gates (Phase 2)
# CONFIDENCE_AUTO_FLAG_BELOW: Score strictly below which a document is auto-flagged as non-compliant (default: 0.6)
CONFIDENCE_AUTO_FLAG_BELOW=0.6
# CONFIDENCE_HUMAN_REVIEW_BELOW: Score strictly below which a document requires human officer review (default: 0.8)
CONFIDENCE_HUMAN_REVIEW_BELOW=0.8

# CORS Security (Phase 8)
# CORS_ORIGIN: Allowed front-end origin header (strict match, rejects unauthorized origins)
CORS_ORIGIN="http://localhost:5173"

# Demo Mode & Offline Failover (Phase 9 & 10 Runbook)
# DEMO_MODE: When true, verification uses pre-computed cryptographic fixtures for zero-latency offline demo presentations
DEMO_MODE=false

# Rate Limiting Controls (Phase 8 & 10)
# ENABLE_RATE_LIMITS: Explicitly enable rate limiters even in test environments (default: false in test, true in dev/prod)
ENABLE_RATE_LIMITS=false
# RATE_LIMIT_TEST_MODE: When true, compresses 1m/15m rate limiting windows to 3s/4s for rapid automated test assertions
RATE_LIMIT_TEST_MODE=false
